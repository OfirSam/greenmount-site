---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import TrustBar from '@/components/TrustBar.astro';
import Steps from '@/components/Steps.astro';
import Kids from '@/components/Kids.astro';
import Disciplines from '@/components/Disciplines.astro';
import Coach from '@/components/Coach.astro';
import Why from '@/components/Why.astro';
import Testimonials from '@/components/Testimonials.astro';
import Gallery from '@/components/Gallery.astro';
import Instagram from '@/components/Instagram.astro';
import Schedule from '@/components/Schedule.astro';
import Faq from '@/components/Faq.astro';
import Trial from '@/components/Trial.astro';
import Footer from '@/components/Footer.astro';
import StickyCtas from '@/components/StickyCtas.astro';
import JsonLd from '@/components/JsonLd.astro';
import { site } from '@/config/site';
---

<Base>
	<JsonLd slot="head" />
	<Header />
	<main id="main">
		<!-- Decision flow: what is it → proof → how to start → which program → who teaches → why → proof → when → questions → book -->
		<Hero />
		<TrustBar />
		<Steps />
		<Kids />
		<Disciplines />
		<Coach />
		<Why />
		<Testimonials />
		<Gallery />
		{site.instagram.beholdFeedUrl && <Instagram />}
		<Schedule />
		<Faq />
		<Trial />
	</main>
	<Footer />
	<StickyCtas />
</Base>
