---
import { getEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';

const faq = (await getEntry('faq', 'main'))!.data.items;
---

<section id="faq" class="section faq" aria-labelledby="faq-title">
	<div class="wrap faq-grid">
		<SectionHead id="faq-title" eyebrow="שאלות" title="שאלות **נפוצות**" />

		<div class="faq-list" data-reveal>
			{
				faq.map((item, i) => (
					<details class="faq-item" name="faq" data-faq={i}>
						<summary class="faq-q">
							<span>{item.q}</span>
							<span class="faq-toggle" aria-hidden="true" />
						</summary>
						<div class="faq-a">
							<p>{item.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq-grid {
		display: grid;
		gap: 1rem;
	}
	.faq-list {
		border-top: 1px solid var(--color-line);
	}
	.faq-item {
		border-bottom: 1px solid var(--color-line);
	}
	.faq-q {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 3rem;
		padding-block: 1.4rem;
		font-weight: 800;
		font-size: clamp(1.15rem, 1.9vw, 1.375rem);
		line-height: 1.35;
		cursor: pointer;
		list-style: none;
		transition: color 0.2s;
	}
	.faq-q::-webkit-details-marker {
		display: none;
	}
	.faq-q:hover {
		color: var(--color-green);
	}
	.faq-toggle {
		position: relative;
		flex: none;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		border: 1.5px solid rgb(243 239 231 / 0.3);
		transition:
			background-color 0.3s,
			border-color 0.3s,
			transform 0.45s var(--ease-out-expo);
	}
	.faq-toggle::before,
	.faq-toggle::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0.9rem;
		height: 2px;
		margin: -1px 0 0 -0.45rem;
		background: currentColor;
		border-radius: 2px;
		transition: transform 0.45s var(--ease-out-expo);
	}
	.faq-toggle::after {
		transform: rotate(90deg);
	}
	.faq-item[open] .faq-toggle {
		background: var(--color-green);
		border-color: var(--color-green);
		color: var(--color-ink);
		transform: rotate(180deg);
	}
	.faq-item[open] .faq-toggle::after {
		transform: rotate(0deg);
	}
	.faq-item[open] .faq-q {
		color: var(--color-green);
	}
	.faq-a {
		padding-bottom: 1.6rem;
		max-width: 46rem;
		font-size: 1.1rem;
		color: rgb(243 239 231 / 0.85);
	}

	/* Smooth open/close where supported */
	@supports (interpolate-size: allow-keywords) {
		.faq-item {
			interpolate-size: allow-keywords;
		}
		.faq-item::details-content {
			height: 0;
			overflow: clip;
			transition:
				height 0.45s var(--ease-out-expo),
				content-visibility 0.45s allow-discrete;
		}
		.faq-item[open]::details-content {
			height: auto;
		}
	}

	@media (min-width: 64rem) {
		.faq-grid {
			grid-template-columns: 0.8fr 1.2fr;
			gap: 4rem;
			align-items: start;
		}
	}
</style>
