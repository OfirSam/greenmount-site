---
/**
 * Final CTA: trial-booking form (Netlify Forms) + location.
 * Netlify detects the form at deploy time from the static HTML (data-netlify).
 * src/scripts/form.ts submits it with fetch and shows the inline success state;
 * without JS it posts normally and lands on /thanks.
 */
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { site, waLink } from '@/config/site';
import { DISCIPLINE_LABELS, GROUP_LABELS, image } from '@/lib/content';

const trial = (await getEntry('trial', 'main'))!.data;
const bg = image('brand', 'shirt-back.jpg');
const loc = site.location;
const q = encodeURIComponent(loc.mapQuery);
const mapEmbed = `https://www.google.com/maps?q=${q}&hl=iw&z=14&output=embed`;
const gmaps = `https://www.google.com/maps/search/?api=1&query=${q}`;
const waze = `https://waze.com/ul?q=${q}&navigate=yes`;
---

<section id="trial" class="section trial" aria-labelledby="trial-title">
	{
		bg && (
			<div class="trial-bg" aria-hidden="true">
				<Picture src={bg} formats={['avif', 'webp']} widths={[768, 1280, 1920]} sizes="100vw" alt="" loading="lazy" />
			</div>
		)
	}

	<div class="wrap">
		<header class="trial-head">
			<p class="eyebrow" data-reveal>{trial.eyebrow}</p>
			<h2 id="trial-title" class="trial-title" data-reveal style="--d:1">{trial.title}</h2>
			<p class="lead" data-reveal style="--d:2">{trial.text}</p>
		</header>

		<div class="trial-grid">
			<!-- ── Booking form ─────────────────────────────── -->
			<div class="form-card card" data-reveal>
				<h3 class="h3">{trial.formTitle}</h3>

				<form
					name="trial"
					method="POST"
					action="/thanks"
					data-netlify="true"
					netlify-honeypot="bot-field"
					class="t-form"
					data-trial-form
					novalidate
				>
					<input type="hidden" name="form-name" value="trial" />
					<div class="hp" aria-hidden="true">
						<label>
							לא למלא
							<input name="bot-field" tabindex="-1" autocomplete="off" />
						</label>
					</div>

					<div class="field">
						<label for="f-name">שם מלא</label>
						<input
							id="f-name"
							name="name"
							type="text"
							required
							autocomplete="name"
							placeholder="שם פרטי ושם משפחה"
							aria-describedby="f-name-err"
						/>
						<p class="field-err" id="f-name-err" hidden>נא למלא שם</p>
					</div>

					<div class="field">
						<label for="f-phone">טלפון</label>
						<input
							id="f-phone"
							name="phone"
							type="tel"
							inputmode="tel"
							required
							autocomplete="tel"
							dir="ltr"
							placeholder="050-000-0000"
							aria-describedby="f-phone-err"
						/>
						<p class="field-err" id="f-phone-err" hidden>נא למלא מספר טלפון תקין</p>
					</div>

					<fieldset class="field">
						<legend>קבוצת גיל</legend>
						<div class="seg" role="radiogroup" aria-describedby="f-group-err">
							{
								(Object.entries(GROUP_LABELS) as Array<[string, string]>).map(([value, label], i) => (
									<label class="seg-opt">
										<input type="radio" name="group" value={label} required={i === 0} data-group-key={value} />
										<span>{label}</span>
									</label>
								))
							}
						</div>
						<p class="field-err" id="f-group-err" hidden>נא לבחור קבוצת גיל</p>
					</fieldset>

					<div class="field">
						<label for="f-discipline">תחום שמעניין אתכם</label>
						<div class="select-wrap">
							<select id="f-discipline" name="discipline" data-discipline-select>
								<option value="עזרו לי לבחור">עוד לא יודעים – עזרו לנו לבחור</option>
								{
									(Object.entries(DISCIPLINE_LABELS) as Array<[string, string]>).map(([key, label]) => (
										<option value={label} data-key={key}>
											{label}
										</option>
									))
								}
							</select>
							<Icon name="chevron-down" class="select-icon" />
						</div>
					</div>

					<div class="field">
						<label for="f-message">הודעה <span class="optional">(לא חובה)</span></label>
						<textarea
							id="f-message"
							name="message"
							rows="3"
							placeholder="למשל: גיל הילד/ה, ניסיון קודם, ימים ושעות שנוחים לכם"></textarea>
					</div>

					<button type="submit" class="btn btn-gold btn-xl t-submit">
						<span class="t-submit-label">{trial.submit}</span>
						<Icon name="arrow-forward" class="btn-arrow" />
					</button>

					<p class="t-privacy">
						שליחת הטופס מאשרת שניצור איתכם קשר לתיאום אימון ניסיון. <a class="link" href="/privacy">מדיניות פרטיות</a>
					</p>

					<p class="t-error" role="alert" data-form-error hidden>
						<Icon name="alert" />
						<span>
							משהו השתבש בשליחה. נסו שוב או <a
								class="link"
								href={waLink('trial')}
								target="_blank"
								rel="noopener"
								data-track="whatsapp"
								data-src="form-error">שלחו לנו הודעה בוואטסאפ</a
							>.
						</span>
					</p>
				</form>

				<div class="t-success" data-form-success hidden tabindex="-1">
					<span class="t-success-icon"><Icon name="check" /></span>
					<p class="h3">{trial.success.title}</p>
					<p class="lead">{trial.success.text}</p>
				</div>

				<div class="t-wa">
					<span>{trial.waAlt}</span>
					<a
						class="btn btn-outline btn-lg"
						href={waLink('trial')}
						target="_blank"
						rel="noopener"
						data-track="whatsapp"
						data-src="trial-section"
						data-context="trial"
					>
						<Icon name="whatsapp" class="wa-icon" />
						שלחו לנו הודעה
					</a>
				</div>
			</div>

			<!-- ── Location ─────────────────────────────────── -->
			<div id="location" class="loc-card card" data-reveal style="--d:1">
				<div class="loc-map">
					<iframe
						src={mapEmbed}
						title={`מפה – GREENMOUNT, ${loc.locality}`}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
				</div>
				<div class="loc-body">
					<h3 class="h3">איך מגיעים</h3>
					<ul class="loc-list">
						<li>
							<Icon name="map-pin" />
							<div>
								<p class="loc-strong">{loc.address || loc.short}</p>
								{!loc.address && <p class="muted">לכתובת המדויקת – שלחו לנו הודעה בוואטסאפ.</p>}
								{loc.directions && <p class="muted">{loc.directions}</p>}
							</div>
						</li>
						<li>
							<Icon name="clock" />
							<div>
								{
									loc.hours.length ? (
										loc.hours.map((h) => <p>{h}</p>)
									) : (
										<p>
											שעות האימונים –{' '}
											<a class="link" href="#schedule">
												במערכת השעות
											</a>
										</p>
									)
								}
							</div>
						</li>
						<li>
							<Icon name="phone" />
							<a class="link" href={`tel:${site.phone}`} dir="ltr" data-track="phone" data-src="location">
								{site.phoneDisplay}
							</a>
						</li>
					</ul>
					<div class="loc-nav">
						<a class="btn btn-outline btn-sm" href={waze} target="_blank" rel="noopener" data-track="navigate" data-src="waze">
							<Icon name="navigation" />
							Waze
						</a>
						<a class="btn btn-outline btn-sm" href={gmaps} target="_blank" rel="noopener" data-track="navigate" data-src="google-maps">
							<Icon name="map-pin" />
							Google Maps
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.trial {
		isolation: isolate;
		overflow: hidden;
	}
	.trial-bg {
		position: absolute;
		inset: 0;
		z-index: -1;
	}
	.trial-bg :global(picture),
	.trial-bg :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 60% 40%;
	}
	.trial-bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, var(--color-ink) 0%, rgb(11 15 12 / 0.82) 25%, rgb(11 15 12 / 0.9) 60%, var(--color-ink) 100%),
			radial-gradient(70% 50% at 50% 20%, rgb(0 223 82 / 0.15), transparent 70%);
	}

	.trial-head {
		display: grid;
		justify-items: center;
		gap: 1rem;
		text-align: center;
		max-width: 48rem;
		margin: 0 auto clamp(2.5rem, 5vw, 4rem);
	}
	.trial-title {
		font-size: clamp(3.5rem, 11vw, 8rem);
		line-height: 0.88;
	}

	.trial-grid {
		display: grid;
		gap: 1rem;
	}

	/* ── Form ─────────────────────────────────────────── */
	.form-card {
		padding: clamp(1.5rem, 4vw, 2.5rem);
		background: rgb(17 23 18 / 0.92);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}
	.t-form {
		display: grid;
		gap: 1.1rem;
		margin-top: 1.5rem;
	}
	.hp {
		position: absolute;
		top: 0;
		inset-inline-start: 0;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.field {
		display: grid;
		gap: 0.4rem;
		border: 0;
		padding: 0;
		margin: 0;
		min-width: 0;
	}
	.field > label,
	.field > legend {
		font-size: 0.9375rem;
		font-weight: 700;
		color: rgb(243 239 231 / 0.9);
		padding: 0;
		margin-bottom: 0.4rem;
	}
	.optional {
		font-weight: 400;
		color: var(--color-mute);
	}
	.field input:not([type='radio']),
	.field select,
	.field textarea {
		width: 100%;
		min-height: 3.25rem;
		padding: 0.75rem 1rem;
		border-radius: var(--radius);
		border: 1.5px solid var(--color-line);
		background: var(--color-ink);
		color: var(--color-bone);
		font: inherit;
		font-size: 1rem;
		transition:
			border-color 0.2s,
			box-shadow 0.2s;
	}
	.field input[dir='ltr'] {
		text-align: right;
	}
	.field input::placeholder,
	.field textarea::placeholder {
		color: rgb(163 172 165 / 0.75);
	}
	.field input:focus-visible,
	.field select:focus-visible,
	.field textarea:focus-visible {
		outline: none;
		border-color: var(--color-green);
		box-shadow: 0 0 0 3px rgb(0 223 82 / 0.25);
	}
	.field [aria-invalid='true'] {
		border-color: #ff6b5b !important;
	}
	.field textarea {
		resize: vertical;
		min-height: 6rem;
	}
	.select-wrap {
		position: relative;
	}
	.select-wrap select {
		appearance: none;
		padding-inline-end: 2.75rem;
		cursor: pointer;
	}
	.select-wrap :global(.select-icon) {
		position: absolute;
		inset-inline-end: 1rem;
		top: 50%;
		translate: 0 -50%;
		width: 1.1rem;
		height: 1.1rem;
		pointer-events: none;
		color: var(--color-mute);
	}
	.field-err {
		font-size: 0.875rem;
		font-weight: 600;
		color: #ff8a7d;
	}

	/* Segmented radio buttons */
	.seg {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.4rem;
	}
	.seg-opt {
		position: relative;
	}
	.seg-opt input {
		position: absolute;
		opacity: 0;
		inset: 0;
		cursor: pointer;
	}
	.seg-opt span {
		display: grid;
		place-items: center;
		min-height: 3.25rem;
		border-radius: var(--radius);
		border: 1.5px solid var(--color-line);
		background: var(--color-ink);
		font-weight: 700;
		transition:
			background-color 0.2s,
			border-color 0.2s,
			color 0.2s;
	}
	.seg-opt:hover span {
		border-color: rgb(243 239 231 / 0.4);
	}
	.seg-opt input:checked + span {
		background: var(--color-green);
		border-color: var(--color-green);
		color: var(--color-ink);
	}
	.seg-opt input:focus-visible + span {
		outline: 3px solid var(--color-green);
		outline-offset: 2px;
	}

	.t-submit {
		width: 100%;
		margin-top: 0.4rem;
	}
	.t-submit[aria-busy='true'] {
		opacity: 0.7;
		pointer-events: none;
	}
	.t-privacy {
		font-size: 0.8125rem;
		color: var(--color-mute);
	}
	.t-error {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		border-radius: var(--radius);
		background: rgb(255 107 91 / 0.1);
		border: 1px solid rgb(255 107 91 / 0.35);
		color: #ffb3aa;
		font-size: 0.9375rem;
	}
	.t-error[hidden] {
		display: none;
	}
	.t-error :global(svg) {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		margin-top: 0.1rem;
	}

	.t-success {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		padding-block: 2.5rem 1rem;
		text-align: center;
		outline: none;
	}
	.t-success[hidden] {
		display: none;
	}
	.t-success-icon {
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 999px;
		background: var(--color-green);
		color: var(--color-ink);
		animation: pop 0.6s var(--ease-out-expo);
	}
	.t-success-icon :global(svg) {
		width: 2.25rem;
		height: 2.25rem;
		stroke-width: 2.5;
	}
	@keyframes pop {
		from {
			transform: scale(0.4);
			opacity: 0;
		}
	}

	.t-wa {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 1.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-line);
		font-weight: 600;
	}

	/* ── Location ─────────────────────────────────────── */
	.loc-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: rgb(17 23 18 / 0.92);
	}
	.loc-map {
		position: relative;
		aspect-ratio: 16 / 10;
		background: var(--color-ink-3);
	}
	.loc-map iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		/* dark-theme the map to match the site */
		filter: invert(0.9) hue-rotate(180deg) saturate(0.6) contrast(0.95);
	}
	.loc-body {
		padding: clamp(1.5rem, 4vw, 2.25rem);
	}
	.loc-list {
		display: grid;
		gap: 1.1rem;
		margin-top: 1.25rem;
	}
	.loc-list li {
		display: flex;
		gap: 0.85rem;
		align-items: flex-start;
	}
	.loc-list li > :global(svg) {
		flex: none;
		width: 1.4rem;
		height: 1.4rem;
		margin-top: 0.15rem;
		color: var(--color-green);
	}
	.loc-strong {
		font-weight: 700;
	}
	.loc-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}
	.loc-nav :global(svg) {
		color: var(--color-green);
	}

	@media (min-width: 64rem) {
		.trial-grid {
			grid-template-columns: 1.15fr 0.85fr;
			align-items: start;
		}
		.loc-map {
			aspect-ratio: 4 / 3;
		}
	}
</style>
