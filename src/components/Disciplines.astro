---
/**
 * Youth & adult programs – all 6 visible at once; each tile links to its program page.
 * Content: src/data/disciplines.yaml (+ section titles in disciplines-section.yaml)
 */
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { image, landingFor } from '@/lib/content';

const section = (await getEntry('disciplinesSection', 'main'))!.data;
const pages = (await getEntry('landing', 'main'))!.data.items;
const items = (await getEntry('disciplines', 'main'))!.data.items.map((d) => ({
	...d,
	src: image('disciplines', d.image),
	page: landingFor(pages, d.id),
	// keep "X / Y" from breaking right before the slash
	display: d.name.replace(' / ', ' / '),
}));
---

<section id="disciplines" class="section disciplines" aria-labelledby="disciplines-title">
	<div class="wrap">
		<SectionHead id="disciplines-title" eyebrow={section.eyebrow} title={section.title} intro={section.intro} />

		<ul class="d-grid">
			{
				items.map((d, i) => (
					<li data-reveal style={`--d:${i % 3}`}>
						<a
							class="d-tile"
							href={d.page ? `/${d.page.slug}` : '#trial'}
							data-variant={d.src ? 'photo' : 'plain'}
							data-track="discipline"
							data-src={d.id}
						>
							<span class="d-media" aria-hidden="true">
								{d.src ? (
									<Picture
										src={d.src}
										formats={['avif', 'webp']}
										widths={[360, 640, 900]}
										sizes="(min-width: 64rem) 30vw, 46vw"
										alt=""
										loading="lazy"
									/>
								) : (
									<svg class="d-ridges" viewBox="0 0 400 300" preserveAspectRatio="none">
										<path d="M0 230 90 150l50 40 70-90 60 60 40-30 90 100" />
										<path d="M0 260 110 190l60 30 80-70 50 40 50-20 50 60" />
									</svg>
								)}
							</span>
							<span class="d-latin font-latin" lang="en" aria-hidden="true">
								{d.latin}
							</span>
							<span class="d-body">
								<span class="d-name">{d.display}</span>
								<span class="d-short">{d.short}</span>
								<span class="d-more">
									{section.moreLabel}
									<Icon name="arrow-forward" />
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Phones: 2 columns of compact tiles · Desktop: 3×2 cards */
	.d-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.d-tile {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		height: 100%;
		min-height: 10.5rem;
		overflow: hidden;
		border-radius: calc(var(--radius) * 1.5);
		border: 1px solid var(--color-line);
		background: var(--color-ink-2);
		color: var(--color-bone);
		text-decoration: none;
		transition:
			border-color 0.3s,
			transform 0.45s var(--ease-out-expo);
	}
	.d-tile:hover {
		border-color: var(--color-green);
		transform: translateY(-3px);
	}
	.d-tile:active {
		transform: scale(0.98);
	}
	.d-media {
		position: absolute;
		inset: 0;
		z-index: -2;
	}
	.d-media :global(picture),
	.d-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.d-media :global(img) {
		transition: transform 1.2s var(--ease-out-expo);
	}
	.d-tile:hover .d-media :global(img) {
		transform: scale(1.06);
	}
	.d-tile[data-variant='photo']::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(to top, rgb(11 15 12 / 0.95) 20%, rgb(11 15 12 / 0.35) 70%, rgb(11 15 12 / 0.1));
	}
	.d-tile[data-variant='plain'] .d-media {
		background:
			radial-gradient(90% 70% at 85% 0%, rgb(0 223 82 / 0.22), transparent 65%),
			linear-gradient(160deg, var(--color-green-deep), var(--color-ink-2) 60%);
	}
	.d-ridges {
		position: absolute;
		inset-inline: 0;
		top: 10%;
		width: 100%;
		height: 55%;
		fill: none;
		stroke: rgb(0 223 82 / 0.35);
		stroke-width: 1.2;
		vector-effect: non-scaling-stroke;
	}
	.d-ridges path:nth-child(2) {
		stroke: rgb(0 223 82 / 0.18);
	}
	.d-latin {
		position: absolute;
		top: 0.75rem;
		inset-inline-end: 0.85rem;
		max-width: 85%;
		font-weight: 800;
		font-size: clamp(1.5rem, 6vw, 4rem);
		line-height: 0.9;
		text-align: end;
		direction: ltr;
		color: transparent;
		-webkit-text-stroke: 1px rgb(243 239 231 / 0.5);
	}
	.d-body {
		display: grid;
		gap: 0.5rem;
		padding: 0.9rem;
	}
	.d-name {
		font-weight: 800;
		font-size: 1.05rem;
		line-height: 1.25;
	}
	.d-short {
		display: none;
		color: rgb(243 239 231 / 0.82);
		line-height: 1.55;
	}
	.d-more {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--color-green);
	}
	.d-more :global(svg) {
		width: 1rem;
		height: 1rem;
		transition: transform 0.3s var(--ease-out-expo);
	}
	.d-tile:hover .d-more :global(svg) {
		transform: translateX(-4px);
	}

	@media (min-width: 48rem) {
		.d-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
		}
		.d-tile {
			min-height: 24rem;
		}
		.d-body {
			gap: 0.75rem;
			padding: 1.5rem;
		}
		.d-name {
			font-family: var(--font-display);
			font-weight: 700;
			font-size: clamp(1.9rem, 2.6vw, 2.4rem);
			line-height: 1;
		}
		.d-short {
			display: block;
		}
		.d-more {
			font-size: 1rem;
		}
	}
</style>
