---
/** "למה דווקא GREENMOUNT?" – solid green band (content: src/data/why.yaml). */
import { getEntry } from 'astro:content';

const reasons = (await getEntry('why', 'main'))!.data.items;
---

<section id="why" class="why" aria-labelledby="why-title">
	<div class="wrap">
		<header class="why-head">
			<p class="why-eyebrow" data-reveal>הסיבה שחוזרים</p>
			<h2 id="why-title" class="why-title" data-reveal style="--d:1">
				למה דווקא <span class="font-latin" lang="en">GREENMOUNT?</span>
			</h2>
		</header>

		<ol class="why-list">
			{
				reasons.map((r, i) => (
					<li class="why-item" data-reveal style={`--d:${i}`}>
						<span class="why-num num" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</span>
						<div>
							<h3 class="why-item-title">{r.title}</h3>
							<p class="why-text">{r.text}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.why {
		position: relative;
		padding-block: clamp(3.5rem, 8vw, 6.5rem);
		background: var(--color-green);
		color: var(--color-ink);
		overflow: hidden;
	}
	/* subtle peak texture */
	.why::before {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 60%;
		background: linear-gradient(to top, rgb(0 0 0 / 0.08), transparent);
		clip-path: polygon(0 60%, 18% 25%, 32% 45%, 52% 0, 68% 38%, 80% 22%, 100% 50%, 100% 100%, 0 100%);
		pointer-events: none;
	}
	.why-head {
		position: relative;
	}
	.why-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.875rem;
		font-weight: 800;
		letter-spacing: 0.04em;
	}
	.why-eyebrow::before {
		content: '';
		width: 2rem;
		height: 2px;
		background: currentColor;
	}
	.why-title {
		margin-top: 0.9rem;
		font-size: clamp(2.6rem, 7vw, 5rem);
		line-height: 0.95;
	}
	.why-title .font-latin {
		font-weight: 800;
	}
	.why-list {
		position: relative;
		display: grid;
		gap: 0;
		margin-top: clamp(1.75rem, 4vw, 3rem);
	}
	.why-item {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0 1rem;
		align-items: baseline;
		padding-block: 1rem;
		border-top: 1.5px solid rgb(11 15 12 / 0.2);
	}
	.why-num {
		font-size: 1.1rem;
		font-weight: 800;
		min-width: 2ch;
	}
	.why-item-title {
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1.25rem;
		line-height: 1.3;
	}
	.why-text {
		margin-top: 0.2rem;
		font-weight: 600;
		line-height: 1.5;
		color: rgb(11 15 12 / 0.85);
	}

	@media (min-width: 64rem) {
		.why-list {
			grid-template-columns: repeat(5, minmax(0, 1fr));
			gap: 1.5rem;
		}
		.why-item {
			grid-template-columns: 1fr;
			gap: 0.75rem;
			padding-top: 1.25rem;
			border-top-width: 2px;
		}
		.why-num {
			font-size: 2.75rem;
			line-height: 1;
		}
	}
</style>
