---
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import CtaRow from './CtaRow.astro';
import SectionHead from './SectionHead.astro';
import { image } from '@/lib/content';

const reasons = (await getEntry('why', 'main'))!.data.items;
const photo = image('gallery', '02-after-the-fight.jpg');
---

<section id="why" class="section why" aria-labelledby="why-title">
	<div class="wrap why-grid">
		<div class="why-side">
			<SectionHead id="why-title" eyebrow="הסיבה שחוזרים" title="למה דווקא **GREENMOUNT?**" />
			{
				photo && (
					<div class="why-photo peak-mask" data-reveal>
						<Picture
							src={photo}
							formats={['avif', 'webp']}
							widths={[480, 768, 1080]}
							sizes="(min-width: 64rem) 38vw, 92vw"
							alt="חיבוק אחרי קרב בפינת הזירה"
							loading="lazy"
						/>
					</div>
				)
			}
		</div>

		<ol class="why-list">
			{
				reasons.map((r, i) => (
					<li class="why-item" data-reveal>
						<span class="why-num num" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</span>
						<div>
							<h3 class="why-title">{r.title}</h3>
							<p class="why-text">{r.text}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
	<div class="wrap">
		<CtaRow src="why" primary="קבעו אימון ניסיון" class="why-cta" />
	</div>
</section>

<style>
	/* Dark base (not green) so the green numbers/heading stay the brightest thing in the section */
	.why {
		background:
			radial-gradient(55% 45% at 0% 35%, rgb(0 223 82 / 0.09), transparent 70%),
			var(--color-ink-2);
	}
	.why::before {
		/* subtle top ridge transition from the previous section */
		content: '';
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: 6rem;
		background: linear-gradient(to bottom, var(--color-ink), transparent);
		opacity: 0.8;
		pointer-events: none;
	}
	.why-grid {
		position: relative;
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}
	.why-photo {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}
	.why-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.why-list {
		display: grid;
		counter-reset: why;
	}
	.why-item {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1.25rem clamp(1.25rem, 3vw, 2.5rem);
		align-items: baseline;
		padding-block: clamp(1.5rem, 3vw, 2.25rem);
		border-bottom: 1px solid rgb(243 239 231 / 0.14);
		transition: padding 0.4s var(--ease-out-expo);
	}
	.why-item:first-child {
		border-top: 1px solid rgb(243 239 231 / 0.14);
	}
	.why-num {
		font-size: clamp(3.25rem, 7vw, 5.5rem);
		font-weight: 800;
		line-height: 0.8;
		color: transparent;
		-webkit-text-stroke: 1.5px var(--color-green);
		transition: color 0.35s;
		min-width: 2ch;
	}
	.why-item:hover .why-num {
		color: var(--color-green);
	}
	.why-title {
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 4vw, 3.25rem);
		line-height: 1;
	}
	.why-text {
		margin-top: 0.5rem;
		font-size: 1.1rem;
		color: rgb(243 239 231 / 0.82);
		max-width: 34rem;
	}
	.why-cta {
		margin-top: 3rem;
	}

	@media (min-width: 64rem) {
		.why-grid {
			grid-template-columns: 0.85fr 1.15fr;
			align-items: start;
		}
		.why-side {
			position: sticky;
			top: calc(var(--header-h) + 2rem);
		}
	}
</style>
