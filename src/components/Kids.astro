---
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { image, rich } from '@/lib/content';

const kids = (await getEntry('kids', 'main'))!.data;
const photos = kids.images
	.map((p) => ({ ...p, src: image('kids', p.file) }))
	.filter((p): p is typeof p & { src: NonNullable<typeof p.src> } => Boolean(p.src));
---

<section id="kids" class="section kids" aria-labelledby="kids-title">
	<div class="wrap">
		<div class="kids-intro">
			<div>
				<SectionHead id="kids-title" eyebrow={kids.eyebrow} title={kids.title} />
				<div class="prose kids-prose" data-reveal style="--d:2">
					{kids.paragraphs.map((p) => <p set:html={rich(p)} />)}
				</div>
			</div>

			<div class="kids-photos">
				{
					photos.map((p, i) => (
						<div class:list={['photo', `kp-${i}`, { 'peak-mask': i === 0 }]} data-reveal style={`--d:${i}`}>
							<Picture
								src={p.src}
								formats={['avif', 'webp']}
								widths={i === 0 ? [480, 768, 1080] : [320, 480, 640]}
								sizes={i === 0 ? '(min-width: 64rem) 32vw, 92vw' : '(min-width: 64rem) 16vw, 45vw'}
								alt={p.alt}
								loading="lazy"
							/>
						</div>
					))
				}
			</div>
		</div>

		<div class="kids-values">
			<h3 class="block-title" data-reveal>{kids.valuesTitle}</h3>
			<ul class="values-grid">
				{
					kids.values.map((v, i) => (
						<li class="value-card" data-reveal style={`--d:${i}`}>
							<span class="value-icon">
								<Icon name={v.icon} />
							</span>
							<span class="value-label">{v.label}</span>
							<span class="value-num num" aria-hidden="true">
								{String(i + 1).padStart(2, '0')}
							</span>
						</li>
					))
				}
			</ul>
			<blockquote class="kids-note" data-reveal>
				<p set:html={rich(kids.note)} />
			</blockquote>
		</div>

		<div class="kids-parents">
			<h3 class="block-title" data-reveal>{kids.parentsTitle}</h3>
			<ul class="parents-grid">
				{
					kids.parents.map((item, i) => (
						<li class="parent-card" data-reveal style={`--d:${i % 2}`}>
							<span class="parent-icon">
								<Icon name={item.icon} />
							</span>
							<div>
								<p class="parent-title">{item.title}</p>
								<p class="parent-text">{item.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>

	</div>
</section>

<style>
	.kids {
		background:
			radial-gradient(70% 50% at 100% 0%, rgb(0 223 82 / 0.08), transparent 70%),
			linear-gradient(to bottom, var(--color-ink), var(--color-ink-2) 30%, var(--color-ink-2) 70%, var(--color-ink));
	}
	.kids-intro {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
	}
	.kids-prose {
		max-width: 38rem;
		font-size: 1.125rem;
	}

	.kids-photos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: auto auto;
		gap: 0.75rem;
	}
	.kp-0 {
		grid-column: 1 / -1;
		aspect-ratio: 3 / 2;
		border-radius: 0;
	}
	.kp-1,
	.kp-2 {
		aspect-ratio: 4 / 3;
	}
	.kids-photos :global(img) {
		transition: transform 1s var(--ease-out-expo);
	}
	.kids-photos .photo:hover :global(img) {
		transform: scale(1.04);
	}

	/* Sub-block headline (one line → display face is fine at this size) */
	.block-title {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 4.5vw, 3.25rem);
		line-height: 1;
		color: var(--color-bone);
	}

	/* Values – compact cards, green icon chip, readable bold sans label */
	.kids-values {
		margin-top: clamp(4rem, 8vw, 6rem);
	}
	.values-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.value-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.4rem 1.25rem 1.3rem;
		border: 1px solid var(--color-line);
		border-radius: calc(var(--radius) * 1.5);
		background: var(--color-ink);
		transition:
			border-color 0.3s,
			transform 0.4s var(--ease-out-expo),
			background-color 0.3s;
	}
	.value-card:hover {
		border-color: rgb(0 223 82 / 0.55);
		background: rgb(0 223 82 / 0.06);
		transform: translateY(-3px);
	}
	.value-card:last-child {
		grid-column: 1 / -1;
	}
	.value-icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 999px;
		background: rgb(0 223 82 / 0.14);
		color: var(--color-green);
	}
	.value-icon :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
		stroke-width: 2;
	}
	.value-label {
		font-weight: 800;
		font-size: 1.15rem;
		line-height: 1.3;
		color: var(--color-bone);
	}
	.value-num {
		position: absolute;
		top: 1.1rem;
		inset-inline-end: 1.15rem;
		font-size: 0.875rem;
		font-weight: 800;
		color: var(--color-green);
		opacity: 0.8;
	}

	/* Pull quote */
	.kids-note {
		margin-top: 2rem;
		max-width: 52rem;
		padding: 1.4rem 1.6rem;
		border-inline-start: 4px solid var(--color-green);
		border-radius: 0 var(--radius) var(--radius) 0;
		background: linear-gradient(to left, rgb(0 223 82 / 0.1), rgb(0 223 82 / 0.02) 70%);
	}
	.kids-note p {
		font-weight: 700;
		font-size: clamp(1.25rem, 2.3vw, 1.65rem);
		line-height: 1.45;
		color: var(--color-bone);
	}
	.kids-note :global(strong) {
		color: var(--color-green);
		font-weight: 800;
	}

	/* Parents – four clear mini-cards */
	.kids-parents {
		margin-top: clamp(3.5rem, 7vw, 5rem);
	}
	.parents-grid {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.parent-card {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 1.35rem 1.25rem;
		border: 1px solid var(--color-line);
		border-radius: calc(var(--radius) * 1.5);
		background: var(--color-ink);
	}
	.parent-icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 3rem;
		height: 3rem;
		border-radius: 999px;
		background: rgb(0 223 82 / 0.14);
		color: var(--color-green);
	}
	.parent-icon :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
		stroke-width: 2;
	}
	.parent-title {
		font-weight: 800;
		font-size: 1.125rem;
		line-height: 1.3;
		color: var(--color-bone);
	}
	.parent-text {
		margin-top: 0.35rem;
		font-size: 1rem;
		line-height: 1.6;
		color: rgb(243 239 231 / 0.8);
	}

	/* Phones: values as a compact list (icon + label on one row) */
	@media (max-width: 47.99rem) {
		.values-grid {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
		.value-card {
			flex-direction: row;
			align-items: center;
			padding: 0.85rem 1rem;
		}
		.value-card:last-child {
			grid-column: auto;
		}
		.value-num {
			position: static;
			margin-inline-start: auto;
		}
	}
	@media (min-width: 48rem) {
		.parents-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.values-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.value-card:last-child {
			grid-column: auto;
		}
	}
	@media (min-width: 64rem) {
		.kids-intro {
			grid-template-columns: 1fr 1fr;
		}
		.values-grid {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
	}
</style>
