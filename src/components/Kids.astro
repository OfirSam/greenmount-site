---
/**
 * Kids program – light ("paper") section for parents.
 * Content: src/data/kids.yaml. The 3rd paragraph (age groups) is shown as the first parents card.
 */
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import Ridge from './Ridge.astro';
import SectionHead from './SectionHead.astro';
import { image, rich } from '@/lib/content';

const kids = (await getEntry('kids', 'main'))!.data;
const photos = kids.images
	.map((p) => ({ ...p, src: image('kids', p.file) }))
	.filter((p): p is typeof p & { src: NonNullable<typeof p.src> } => Boolean(p.src));
const [main, second] = photos;
// Paragraph 3 ("קבוצות לפי גיל") duplicates the first parents card – show it only once
const intro = kids.paragraphs.slice(0, 2);
---

<section id="kids" class="section kids theme-light" aria-labelledby="kids-title">
	<Ridge edge="top" color="var(--color-bone)" />

	<div class="wrap">
		<div class="kids-top">
			<div class="kids-text">
				<SectionHead id="kids-title" eyebrow={kids.eyebrow} title={kids.title} />
				<div class="prose kids-prose" data-reveal style="--d:2">
					{intro.map((p) => <p set:html={rich(p)} />)}
				</div>
				<ul class="values" aria-label={kids.valuesTitle} data-reveal style="--d:3">
					{
						kids.values.map((v) => (
							<li>
								<Icon name={v.icon} />
								{v.label}
							</li>
						))
					}
				</ul>
			</div>

			<div class="kids-media" data-reveal>
				{
					main && (
						<div class="kids-photo peak-mask">
							<Picture
								src={main.src}
								formats={['avif', 'webp']}
								widths={[480, 768, 1080]}
								sizes="(min-width: 64rem) 44vw, 92vw"
								alt={main.alt}
								loading="lazy"
							/>
						</div>
					)
				}
				{
					second && (
						<div class="kids-photo-2">
							<Picture
								src={second.src}
								formats={['avif', 'webp']}
								widths={[320, 480]}
								sizes="(min-width: 64rem) 16vw, 36vw"
								alt={second.alt}
								loading="lazy"
							/>
						</div>
					)
				}
			</div>
		</div>

		<blockquote class="kids-note" data-reveal>
			<p set:html={rich(kids.note)} />
		</blockquote>

		<div class="kids-parents">
			<h3 class="parents-title" data-reveal>{kids.parentsTitle}</h3>
			<ul class="parents-grid">
				{
					kids.parents.map((item, i) => (
						<li class="parent" data-reveal style={`--d:${i % 2}`}>
							<span class="parent-icon">
								<Icon name={item.icon} />
							</span>
							<div>
								<p class="parent-title">{item.title}</p>
								<p class="parent-text">{item.text}</p>
							</div>
						</li>
					))
				}
			</ul>
			<a class="link kids-more" href="/kids" data-reveal>
				כל הפרטים על החוג לילדים
				<Icon name="arrow-forward" />
			</a>
		</div>
	</div>

	<Ridge edge="bottom" color="var(--color-ink)" />
</section>

<style>
	.kids {
		padding-bottom: calc(var(--section-y) + clamp(1rem, 3vw, 2.5rem));
	}
	.kids-top {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.kids-prose {
		max-width: 38rem;
		font-size: 1.1rem;
	}

	/* Values as tags */
	.values {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}
	.values li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		background: #fff;
		border: 1px solid var(--color-line);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-ink);
	}
	.values :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
		color: var(--color-green-ink);
		stroke-width: 2;
	}

	/* Photos – full color here (warmth for parents) */
	.kids-media {
		position: relative;
		padding-bottom: 2rem;
	}
	.kids-photo {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 0 0 var(--radius) var(--radius);
	}
	.kids-photo :global(img),
	.kids-photo-2 :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.kids-photo-2 {
		position: absolute;
		inset-inline-start: -0.5rem;
		bottom: 0;
		width: 38%;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: var(--radius);
		border: 4px solid var(--color-bone);
		box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.45);
	}

	/* Pull quote */
	.kids-note {
		margin-top: clamp(2rem, 5vw, 3.5rem);
		padding: 1.25rem 1.5rem;
		border-inline-start: 4px solid var(--color-green);
		border-radius: 0 var(--radius) var(--radius) 0;
		background: #fff;
	}
	.kids-note p {
		font-weight: 700;
		font-size: clamp(1.15rem, 2.2vw, 1.5rem);
		line-height: 1.45;
		color: var(--color-ink);
	}
	.kids-note :global(strong) {
		padding-inline: 0.2em;
		background: linear-gradient(transparent 55%, rgb(0 223 82 / 0.55) 55%);
		font-weight: 800;
	}

	/* Parents */
	.kids-parents {
		margin-top: clamp(2.25rem, 5vw, 3.5rem);
	}
	.parents-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 4.5vw, 3rem);
		line-height: 1;
		color: var(--color-ink);
	}
	.parents-grid {
		display: grid;
		gap: 0.6rem;
		margin-top: 1.25rem;
	}
	.parent {
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
		padding: 1rem 1.1rem;
		border-radius: calc(var(--radius) * 1.5);
		background: #fff;
		border: 1px solid var(--color-line);
	}
	.parent-icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 999px;
		background: rgb(0 223 82 / 0.2);
		color: var(--color-green-deep);
	}
	.parent-icon :global(svg) {
		width: 1.35rem;
		height: 1.35rem;
		stroke-width: 2;
	}
	.parent-title {
		font-weight: 800;
		font-size: 1.05rem;
		color: var(--color-ink);
	}
	.parent-text {
		margin-top: 0.2rem;
		font-size: 0.975rem;
		line-height: 1.55;
		color: #3d453f;
	}
	.kids-more {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.25rem;
		font-weight: 700;
	}
	.kids-more :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}

	/* Phones: one card with divided rows instead of 4 separate cards */
	@media (max-width: 47.99rem) {
		.parents-grid {
			gap: 0;
			border: 1px solid var(--color-line);
			border-radius: calc(var(--radius) * 1.5);
			background: #fff;
			overflow: hidden;
		}
		.parent {
			padding: 0.9rem 1rem;
			border: 0;
			border-radius: 0;
			background: none;
		}
		.parent + .parent {
			border-top: 1px solid var(--color-line);
		}
		.parent-text {
			font-size: 0.95rem;
		}
	}
	@media (min-width: 48rem) {
		.parents-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}
	}
	@media (min-width: 64rem) {
		.kids-top {
			grid-template-columns: 1.05fr 0.95fr;
		}
		.parents-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.parent {
			flex-direction: column;
		}
	}
</style>
