---
import { Picture, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { site } from '@/config/site';
import { folderImages } from '@/lib/content';

const alts = new Map((await getEntry('gallery', 'main'))!.data.items.map((g) => [g.file, g.alt]));
const photos = await Promise.all(
	folderImages('gallery').map(async ({ file, src }) => {
		const full = await getImage({ src, width: Math.min(src.width, 1800), format: 'webp', quality: 82 });
		return { file, src, full: full.src, alt: alts.get(file) ?? 'אימון ב-GREENMOUNT' };
	}),
);
---

<section id="gallery" class="section gallery" aria-labelledby="gallery-title">
	<div class="wrap">
		<div class="g-head">
			<SectionHead id="gallery-title" eyebrow="גלריה" title="רגעים **מהמזרן**" />
			<a
				class="btn btn-outline btn-sm g-ig"
				href={site.social.instagram}
				target="_blank"
				rel="noopener"
				data-track="social"
				data-src="gallery-instagram"
			>
				<Icon name="instagram" />
				<span>עוד באינסטגרם <span class="font-latin" lang="en" dir="ltr">{site.social.instagramHandle}</span></span>
			</a>
		</div>

		<ul class="g-grid" data-gallery>
			{
				photos.map((p, i) => (
					<li class="g-item" data-reveal style={`--d:${i % 3}`}>
						<button
							type="button"
							class="g-btn"
							data-lightbox-index={i}
							data-full={p.full}
							data-alt={p.alt}
							aria-label={`הגדלת תמונה: ${p.alt}`}
						>
							<Picture
								src={p.src}
								formats={['avif', 'webp']}
								widths={[360, 540, 800]}
								sizes="(min-width: 64rem) 30vw, 46vw"
								alt={p.alt}
								loading="lazy"
							/>
							<span class="g-zoom" aria-hidden="true">
								<Icon name="expand" />
							</span>
						</button>
					</li>
				))
			}
		</ul>
		<p class="g-hint" aria-hidden="true">החליקו לעוד תמונות ←</p>
	</div>

	<dialog class="lightbox" data-lightbox aria-label="גלריית תמונות">
		<div class="lb-stage">
			<img class="lb-img" alt="" data-lb-img />
		</div>
		<p class="lb-caption" data-lb-caption></p>
		<p class="lb-count num" data-lb-count aria-live="polite"></p>
		<button type="button" class="icon-btn lb-close" data-lb-close aria-label="סגירה">
			<Icon name="close" />
		</button>
		<!-- RTL: "next" sits on the left -->
		<button type="button" class="icon-btn lb-prev" data-lb-prev aria-label="התמונה הקודמת">
			<Icon name="chevron-right" />
		</button>
		<button type="button" class="icon-btn lb-next" data-lb-next aria-label="התמונה הבאה">
			<Icon name="chevron-left" />
		</button>
	</dialog>
</section>

<style>
	.g-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0 1.5rem;
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
	}
	.g-head :global(.section-head) {
		margin-bottom: 1rem;
	}
	.g-ig {
		margin-bottom: 1rem;
	}
	.g-ig :global(svg) {
		color: var(--color-green);
	}

	/* Phones: swipeable strip (bleeds to the screen edges) */
	.g-grid {
		display: flex;
		gap: 0.6rem;
		margin-inline: calc(var(--gutter) * -1);
		padding-inline: var(--gutter);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--gutter);
		scrollbar-width: none;
	}
	.g-grid::-webkit-scrollbar {
		display: none;
	}
	.g-item {
		flex: 0 0 72%;
		scroll-snap-align: start;
	}
	.g-btn {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-ink-3);
		cursor: zoom-in;
	}
	.g-btn :global(picture),
	.g-btn :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.g-btn :global(img) {
		transition:
			transform 0.9s var(--ease-out-expo),
			filter 0.4s;
	}
	.g-btn:hover :global(img) {
		transform: scale(1.05);
		filter: brightness(0.8);
	}
	.g-zoom {
		position: absolute;
		inset-inline-end: 0.75rem;
		bottom: 0.75rem;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		background: var(--color-green);
		color: var(--color-ink);
		opacity: 0;
		transform: scale(0.8);
		transition:
			opacity 0.3s,
			transform 0.4s var(--ease-out-expo);
	}
	.g-zoom :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
	}
	.g-btn:hover .g-zoom,
	.g-btn:focus-visible .g-zoom {
		opacity: 1;
		transform: none;
	}
	.g-hint {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--color-mute);
	}

	/* Tablet/desktop: masonry */
	@media (min-width: 48rem) {
		.g-grid {
			display: block;
			columns: 3;
			column-gap: 0.85rem;
			margin-inline: 0;
			padding-inline: 0;
			overflow: visible;
		}
		.g-item {
			break-inside: avoid;
			margin-bottom: 0.85rem;
		}
		.g-btn {
			aspect-ratio: auto;
		}
		.g-btn :global(img) {
			height: auto;
		}
		.g-hint {
			display: none;
		}
	}

	/* Lightbox */
	.lightbox {
		width: 100%;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgb(5 8 6 / 0.96);
		color: var(--color-bone);
	}
	.lightbox::backdrop {
		background: rgb(0 0 0 / 0.7);
	}
	.lightbox[open] {
		display: grid;
		grid-template-rows: 1fr auto;
		animation: modal-in 0.35s var(--ease-out-expo);
	}
	.lb-stage {
		display: grid;
		place-items: center;
		min-height: 0;
		padding: 4.5rem 1rem 0.5rem;
	}
	.lb-img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: var(--radius);
		touch-action: pan-y;
	}
	.lb-caption {
		padding: 0.75rem 1.25rem 0;
		text-align: center;
		color: rgb(243 239 231 / 0.85);
	}
	.lb-count {
		padding: 0.25rem 0 max(1.25rem, env(safe-area-inset-bottom));
		text-align: center;
		font-size: 0.9rem;
		color: var(--color-mute);
	}
	.lb-close {
		position: absolute;
		top: 1rem;
		inset-inline-start: 1rem;
	}
	.lb-prev,
	.lb-next {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		width: 3.25rem;
		height: 3.25rem;
	}
	.lb-prev {
		inset-inline-start: 1rem;
	}
	.lb-next {
		inset-inline-end: 1rem;
	}
	@media (max-width: 47.99rem) {
		.lb-prev,
		.lb-next {
			top: auto;
			bottom: max(0.75rem, env(safe-area-inset-bottom));
			translate: none;
		}
	}
</style>
