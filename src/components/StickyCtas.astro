---
/**
 * Sticky CTA bar (trial + WhatsApp) – appears once the hero CTAs scroll away,
 * hides while the trial form is on screen (logic: initStickyCtas in src/scripts/main.ts).
 * Mobile: full-width bar at the bottom. Desktop: floating centered pill.
 */
import Icon from './Icon.astro';
import { waLink } from '@/config/site';
---

<div class="cta-bar" data-cta-bar data-visible="false">
	<p class="cta-bar-text">בואו לראות בעצמכם <span aria-hidden="true">·</span> אימון ניסיון ללא התחייבות</p>
	<a class="btn btn-gold cta-bar-trial" href="#trial" data-track="trial" data-src="sticky-bar">
		<span class="label-mobile">אימון ניסיון חינם</span>
		<span class="label-desktop">קבעו אימון ניסיון</span>
		<Icon name="arrow-forward" class="btn-arrow" />
	</a>
	<a
		class="cta-bar-wa"
		href={waLink('general')}
		data-wa-dynamic
		target="_blank"
		rel="noopener"
		data-track="whatsapp"
		data-src="sticky-bar"
		aria-label="שלחו לנו הודעה בוואטסאפ"
	>
		<Icon name="whatsapp" />
		<span class="label-desktop">וואטסאפ</span>
	</a>
</div>

<style>
	/* ── Mobile: full-width bottom bar ─────────────────── */
	.cta-bar {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: 45;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.65rem var(--gutter) max(0.65rem, env(safe-area-inset-bottom));
		background: rgb(11 15 12 / 0.92);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-top: 1px solid rgb(243 239 231 / 0.08);
		transform: translateY(110%);
		transition:
			transform 0.45s var(--ease-out-expo),
			opacity 0.35s;
	}
	.cta-bar[data-visible='true'] {
		transform: none;
	}
	.cta-bar-text,
	.label-desktop {
		display: none;
	}
	.cta-bar-trial {
		flex: 1;
		--btn-h: 3.25rem;
	}
	.cta-bar-wa {
		display: grid;
		place-items: center;
		flex: none;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: var(--radius);
		background: var(--color-wa);
		color: var(--color-ink);
		font-weight: 700;
		text-decoration: none;
	}
	.cta-bar-wa :global(svg) {
		width: 1.6rem;
		height: 1.6rem;
	}

	/* ── Desktop: floating centered pill ───────────────── */
	@media (min-width: 48rem) {
		.cta-bar {
			inset-inline: 0;
			bottom: 1.25rem;
			width: fit-content;
			max-width: calc(100% - 10rem); /* stays clear of the accessibility button */
			margin-inline: auto;
			gap: 0.75rem;
			padding: 0.5rem;
			padding-inline-start: 1.5rem;
			border: 1px solid rgb(243 239 231 / 0.12);
			border-radius: 999px;
			background: rgb(17 23 18 / 0.88);
			box-shadow: 0 18px 50px -12px rgb(0 0 0 / 0.75);
			transform: translateY(calc(100% + 2rem));
			opacity: 0;
			pointer-events: none;
		}
		.cta-bar[data-visible='true'] {
			transform: none;
			opacity: 1;
			pointer-events: auto;
		}
		.cta-bar-text {
			display: block;
			font-weight: 600;
			font-size: 0.975rem;
			white-space: nowrap;
			color: rgb(243 239 231 / 0.9);
		}
		.cta-bar-text span {
			margin-inline: 0.35rem;
			color: var(--color-green);
		}
		.label-mobile {
			display: none;
		}
		.label-desktop {
			display: inline;
		}
		.cta-bar-trial {
			flex: none;
			--btn-h: 2.85rem;
			border-radius: 999px;
		}
		.cta-bar-wa {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			width: auto;
			height: 2.85rem;
			padding-inline: 1rem 1.15rem;
			border-radius: 999px;
			transition:
				filter 0.2s,
				transform 0.25s var(--ease-out-quart);
		}
		.cta-bar-wa:hover {
			filter: brightness(1.08);
			transform: translateY(-2px);
		}
		.cta-bar-wa :global(svg) {
			width: 1.3rem;
			height: 1.3rem;
		}
	}
	/* Narrow desktops/tablets: drop the sentence, keep the buttons */
	@media (min-width: 48rem) and (max-width: 63.99rem) {
		.cta-bar-text {
			display: none;
		}
	}
</style>
