---
import { Font } from 'astro:assets';
import { site } from '@/config/site';
import A11yWidget from '@/components/A11yWidget.astro';
import '@/styles/global.css';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title = site.seo.title, description: pageDescription, noindex = false } = Astro.props;
const description = pageDescription ?? site.seo.description;
// Share previews: the page's own description, or the home page's social copy
const shareDescription = pageDescription ?? site.seo.ogDescription;
const shareShort = pageDescription ?? site.seo.twitterDescription;
// Clean URL for canonical/og:url ("/index.html" → "/", "/mma.html" → "/mma") – build.format is 'file'
const cleanPath = Astro.url.pathname.replace(/(^|\/)index(\.html)?$/, '$1').replace(/\.html$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;
const ogImage = new URL(site.seo.ogImage, site.url).href;

// Analytics IDs are always in the page, but tags only fire on the real domain
// (site.analytics.hosts) – localhost, previews and *.netlify.app copies never send data.
const analytics = site.analytics;

// Values the client script needs (read from #gm-config in src/scripts/main.ts)
const clientConfig = {
	analytics,
	heroVideo: site.heroVideo,
	// Audience picker → WhatsApp messages per audience
	wa: {
		number: site.whatsapp.number,
		messages: {
			kids: site.whatsapp.messages.kids,
			youth: site.whatsapp.messages.youth,
			adults: site.whatsapp.messages.adults,
		},
	},
};
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="he" dir="rtl" data-dev={isDev ? '' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<!-- Accessibility widget: apply saved settings before first paint (same key as src/scripts/a11y.ts) -->
		<script is:inline>
			try {
				var a = JSON.parse(localStorage.getItem('gm-a11y') || '{}');
				var h = document.documentElement;
				if (a.scale && a.scale !== 1) {
					h.style.fontSize = a.scale * 100 + '%';
					h.classList.add('a11y-scaled');
				}
				['readable', 'lineHeight', 'contrast', 'grayscale', 'underline', 'bigCursor', 'noMotion'].forEach(function (k) {
					if (a[k]) h.classList.add('a11y-' + k.toLowerCase());
				});
			} catch (e) {}
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
		{!noindex && <link rel="canonical" href={canonical} />}
		<!-- Staging/preview copies (*.netlify.app) must never compete with greenmount.co.il in Google -->
		<script is:inline>
			if (/\.netlify\.app$/.test(location.hostname)) {
				document.querySelector('meta[name="robots"]').setAttribute('content', 'noindex, nofollow');
			}
		</script>
		<meta name="theme-color" content="#0b0f0c" />
		<link rel="icon" href="/favicon.ico" sizes="any" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={shareDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={site.locale} />
		<meta property="og:site_name" content={site.name} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={shareShort} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Fonts: self-hosted, swap + metric-matched fallbacks. All three are preloaded (body too – avoids text reflow/CLS when it swaps in). -->
		<Font cssVariable="--gm-font-he-display" preload />
		<Font cssVariable="--gm-font-body" preload />
		<Font cssVariable="--gm-font-latin-display" preload />

		<!-- GA4 command queue (gtag.js itself is loaded lazily by main.ts) -->
		{
			analytics.ga4 && (
				<script is:inline define:vars={{ id: analytics.ga4, hosts: analytics.hosts }}>
					if (hosts.includes(location.hostname)) {
						window.dataLayer = window.dataLayer || [];
						window.gtag = function () {
							window.dataLayer.push(arguments);
						};
						window.gtag('js', new Date());
						window.gtag('config', id);
					}
				</script>
			)
		}

		<slot name="head" />
	</head>
	<body>
		<a href="#main" class="skip-link">דלגו לתוכן הראשי</a>
		<slot />
		<div class="grain" aria-hidden="true"></div>
		<A11yWidget />
		<script type="application/json" id="gm-config" set:html={JSON.stringify(clientConfig)} />
		<script>
			import '@/scripts/main';
		</script>
	</body>
</html>
