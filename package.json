{
  "name": "greenmount-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-data.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "shots": "node scripts/shots.mjs",
    "images": "node scripts/optimize-images.mjs",
    "video": "node scripts/encode-video.mjs",
    "og": "node scripts/og.mjs",
    "deploy": "npm run build && npx netlify-cli deploy --no-build --dir=dist --prod",
    "deploy:preview": "npm run build && npx netlify-cli deploy --no-build --dir=dist",
    "rollback": "node scripts/rollback.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/assistant": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/karantina": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^6.0.3"
  }
}
